# Copy to .env (gitignored), fill in, then load it before running Terraform:
#   set -a; source .env; set +a
# All secrets live here; terraform.tfvars holds only non-secret settings.

# Catalyst Center (read by the catalystcenter provider)
CC_USERNAME=<CatC admin user>
CC_PASSWORD=<CatC admin password>

# ISE integration, Task 12 (read by data/01 via !env)
ISE_USERNAME=<ISE admin user>
ISE_PASSWORD=<ISE admin password>
ISE_SHARED_SECRET=<RADIUS shared secret>
# Stage 4: password for the lab 802.1X users bob / joe / susan / kim (data/04)
ISE_LAB_USER_PASSWORD=<lab user password>

# FUSION-1 / Catalyst 8000V (read by the nac-iosxe provider; the only supported way)
IOSXE_USERNAME=<C8000V user>
IOSXE_PASSWORD=<C8000V password>
